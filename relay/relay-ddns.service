[Unit]
Description=Update Cloudflare DNS to this VM's current IP on boot
After=network-online.target
Wants=network-online.target
# Restart=on-failure is defensive hardening for a real gap, and to be clear about what it
# is NOT: it was not the cause of the 2026-07-30 fast-route failure. That boot's DDNS
# succeeded (journal: "cf_dns_update(mc-backend): updated to <relay-ip>" at 06:54:11Z).
# The gap it does close: as a bare Type=oneshot with no restart policy, cf_dns_update.ts's
# own ~15s internal retry budget was the ONLY tolerance for the whole boot. Since
# network-online.target can fire before outbound egress is usable on GCE, a slow-network
# boot could burn every attempt inside the dead window, exit 1, and never retry, leaving
# mc-backend on catcher for the entire relay session.
#
# That would not be cosmetic. home-server/join_transfer_watcher.ts transfers players by
# HOSTNAME (Bedrock transfer-mappings are static config keyed on host:port), so while
# mc-backend still resolves to catcher it correctly refuses to transfer anyone: doing so
# would be a same-catcher loopback telling players they're on the fast route when they
# aren't. A lost DNS update would therefore silently cost every player that session the
# fast path, with no error anywhere except a 2-minute lobby timeout.
#
# 20 bursts at RestartSec=15s gives roughly 5 minutes of real tolerance, which comfortably
# outlasts a slow egress bring-up while still giving up eventually instead of spinning.
StartLimitIntervalSec=600
StartLimitBurst=20

[Service]
Type=oneshot
User=YOUR_LINUX_USER
ExecStart=/usr/local/bin/relay_boot_ddns.ts
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target
