# Template for the plaintext secrets file, before encryption.
#
# Copy this file to secrets/wireguard.env.plaintext (drop the .example
# suffix), replace every REPLACE_WITH_REAL_VALUE with the real value, then
# encrypt it with scripts/secrets.sh and delete the plaintext copy. See
# secrets/README.md for the full walkthrough. Never fill this .example file
# in directly, and never commit the renamed, filled-in copy, it's already
# covered by .gitignore but don't rely on that alone.
#
# These lines are meant to be sourced directly (via
# `eval "$(scripts/secrets.sh decrypt secrets/wireguard.env.age)"`), so keep
# them as plain export statements.

export CATCHER_WG_PRIVATE_KEY="REPLACE_WITH_REAL_VALUE"
export HOME_WG_PRIVATE_KEY="REPLACE_WITH_REAL_VALUE"
export WG_PEER_PUBLIC_KEY_CATCHER="REPLACE_WITH_REAL_VALUE"
export WG_PEER_PUBLIC_KEY_HOME="REPLACE_WITH_REAL_VALUE"
export FRP_AUTH_TOKEN="REPLACE_WITH_REAL_VALUE"
